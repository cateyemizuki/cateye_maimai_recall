{
  "manifest_version": 2,
  "id": "github.cateye.maimai-recall",
  "version": "0.1.3",
  "name": "麦麦撤回",
  "description": "为机器人提供消息撤回能力：LLM 工具按消息 ID 撤回指定消息；引用一条消息发送「/撤回」即可撤回被引用的消息；失败时返回具体原因（权限不足、超过时间限制、消息不存在等）。",
  "author": { "name": "cateye", "url": "https://github.com/cateyemizuki" },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/cateyemizuki/cateye_maimai_recall",
    "homepage": "https://github.com/cateyemizuki/cateye_maimai_recall",
    "documentation": "https://github.com/cateyemizuki/cateye_maimai_recall/blob/main/README.md",
    "issues": "https://github.com/cateyemizuki/cateye_maimai_recall/issues"
  },
  "host_application": { "min_version": "1.0.0", "max_version": "1.99.99" },
  "sdk": { "min_version": "2.5.0", "max_version": "2.99.99" },
  "dependencies": [],
  "capabilities": ["send.text", "api.call", "message.get_by_id", "config.get"],
  "i18n": { "default_locale": "zh-CN" },
  "plugin_type": "tool",
  "display": { "icon": { "type": "lucide", "value": "undo-2" } }
}
